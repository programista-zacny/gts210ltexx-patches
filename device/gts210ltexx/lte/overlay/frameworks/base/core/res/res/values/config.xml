<?xml version="1.0" encoding="utf-8"?>
<!--
     LTE build only (WITH_LTE=true): device.mk puts this overlay before ../../overlay, whose
     values are those of the Wi-Fi build. Mobile data and SMS, no voice calls.
-->
<resources>
    <!-- No circuit-switched voice: the audio path for calls (CP_AUDIO_SLSI) is not set up, and
         there is no VoLTE. -->
    <bool name="config_voice_capable">false</bool>

    <!-- SMS through the modem. -->
    <bool name="config_sms_capable">true</bool>

    <!-- Mobile data. -->
    <bool name="config_mobile_data_capable">true</bool>

    <!-- As in gts2-common (the Wi-Fi overlay of this device drops the mobile entries).
         "[Connection name],[ConnectivityManager.TYPE_xxxx],[associated radio-type],[priority],
          [restoral-timer(ms)],[dependencyMet]" -->
    <string-array translatable="false" name="networkAttributes">
        <item>"wifi,1,1,1,-1,true"</item>
        <item>"mobile,0,0,0,-1,true"</item>
        <item>"mobile_mms,2,0,2,60000,true"</item>
        <item>"mobile_supl,3,0,2,60000,true"</item>
        <item>"mobile_dun,4,0,2,60000,true"</item>
        <item>"mobile_hipri,5,0,3,60000,true"</item>
        <item>"mobile_fota,10,0,2,60000,true"</item>
        <item>"mobile_ims,11,0,2,60000,true"</item>
        <item>"mobile_cbs,12,0,2,60000,true"</item>
        <item>"mobile_ia,14,0,2,-1,true"</item>
        <item>"bluetooth,7,7,2,-1,true"</item>
        <item>"ethernet,9,9,9,-1,true"</item>
        <item>"wifi_p2p,13,1,0,-1,true"</item>
    </string-array>
</resources>
