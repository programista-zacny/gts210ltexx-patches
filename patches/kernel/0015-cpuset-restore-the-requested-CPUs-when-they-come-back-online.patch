From: programista-zacny <5969291+programista-zacny@users.noreply.github.com>
Subject: [PATCH] cpuset: restore the requested CPUs when they come back online

A 3.10 cpuset forgets every CPU that goes offline: the hotplug work takes
the CPU out of cpus_allowed of each cpuset and of the tasks in it, and
nothing puts it back when the CPU returns. A write to "cpus" is refused
with EINVAL if it names a CPU that is offline at that moment.

On this board that makes cpusets unusable. The Exynos hotplug governor
(drivers/cpufreq/dm_cpu_hotplug.c) takes cpu1-7 down with cpu_down() when
the screen goes off, and the big cluster also while the screen is on
(thermal, cpufreq_max_limit). After the first screen-off every cpuset
would be left with cpu0 only, for good.

Keep what was written to "cpus" in a second mask, cpus_requested, and
derive cpus_allowed from it: cpus_allowed = cpus_requested & active CPUs,
recomputed by the hotplug work whenever the set of active CPUs changes, in
either direction. The tasks of a cpuset follow as before through
update_tasks_cpumask().

Visible changes:
- "cpus" shows the requested CPUs and no longer shrinks with hotplug. For
  the root cpuset that is all possible CPUs.
- A write to "cpus" may name any present CPU, online or not.
- The subset and exclusivity rules between cpusets are checked on the
  requested masks.
- A cpuset whose requested CPUs are all offline still loses its tasks to
  the parent cpuset, as before.

Derived from the Android common kernel:
  5af78c213b0b "cpuset: Make cpusets restore on hotplug" (android-3.18,
               Riley Andrews, Change-Id
               I3efbae24a1f6384be1e603fb56f0d3baef61d924)
The same change for a 3.10 cpuset.c with the asynchronous hotplug
propagation this tree has is in the Nexus 6P kernel
(android_kernel_huawei_angler 5d64f6810f60); this patch follows that form.
TouseefX/android_kernel_samsung_universal5433 carries it as b4ac4be9433d
on top of the 3.11 cpuset rework, which is not in this tree.

Adapted:
- alloc_trial_cpuset()/free_trial_cpuset() allocate and copy
  cpus_requested. The original left the trial cpuset sharing the mask of
  the live one, which is only correct without CONFIG_CPUMASK_OFFSTACK (the
  case here, NR_CPUS=8).
- Writing an empty string to "cpus" clears cpus_requested too; the
  original cleared cpus_allowed only and then returned early because the
  requested mask had not changed.
- cpuset_hotplug_workfn() loses the cpus_offlined/mems_offlined
  bookkeeping that would be left set but unused.

Compile-tested as part of the cpuset series with CONFIG_CPUSETS=y: full
zImage with the GCC 4.9 arm-linux-androideabi prebuilt, and
kernel/cpuset.o and kernel/cgroup.o at every step of the series; no
warnings in the files touched. Not run on the device.

[combined set, 2026-11-06] Header only, the diff is the staged one. The
paragraph above said "five patches". The series was staged as five
(staging/backport-cpusets 0014-0018) and compiled step by step in that
form; the combined set has four of them, 0015-0018. The fifth, "cpuset:
let CAP_SYS_NICE move other users' tasks into a cpuset" (staged 0015),
is replaced by "cgroup: one credential rule for moving another user's
task" (0014). The four were compiled again in that form, as one zImage
build of the whole combined series, not step by step.
---
 kernel/cpuset.c | 86 ++++++++++++++++++++++++++++++++++++++++++++++++++---------------------------
 1 file changed, 56 insertions(+), 30 deletions(-)

diff --git a/kernel/cpuset.c b/kernel/cpuset.c
index 067750b..98ca6e0 100644
--- a/kernel/cpuset.c
+++ b/kernel/cpuset.c
@@ -85,6 +85,7 @@ struct cpuset {
 
 	unsigned long flags;		/* "unsigned long" so bitops work */
 	cpumask_var_t cpus_allowed;	/* CPUs allowed to tasks in cpuset */
+	cpumask_var_t cpus_requested;	/* CPUs written to "cpus", online or not */
 	nodemask_t mems_allowed;	/* Memory Nodes allowed to tasks */
 
 	struct fmeter fmeter;		/* memory_pressure filter */
@@ -381,7 +382,7 @@ static void cpuset_update_task_spread_flag(struct cpuset *cs,
 
 static int is_cpuset_subset(const struct cpuset *p, const struct cpuset *q)
 {
-	return	cpumask_subset(p->cpus_allowed, q->cpus_allowed) &&
+	return	cpumask_subset(p->cpus_requested, q->cpus_requested) &&
 		nodes_subset(p->mems_allowed, q->mems_allowed) &&
 		is_cpu_exclusive(p) <= is_cpu_exclusive(q) &&
 		is_mem_exclusive(p) <= is_mem_exclusive(q);
@@ -403,7 +404,13 @@ static struct cpuset *alloc_trial_cpuset(const struct cpuset *cs)
 		kfree(trial);
 		return NULL;
 	}
+	if (!alloc_cpumask_var(&trial->cpus_requested, GFP_KERNEL)) {
+		free_cpumask_var(trial->cpus_allowed);
+		kfree(trial);
+		return NULL;
+	}
 	cpumask_copy(trial->cpus_allowed, cs->cpus_allowed);
+	cpumask_copy(trial->cpus_requested, cs->cpus_requested);
 
 	return trial;
 }
@@ -415,6 +422,7 @@ static struct cpuset *alloc_trial_cpuset(const struct cpuset *cs)
 static void free_trial_cpuset(struct cpuset *trial)
 {
 	free_cpumask_var(trial->cpus_allowed);
+	free_cpumask_var(trial->cpus_requested);
 	kfree(trial);
 }
 
@@ -472,7 +480,7 @@ static int validate_change(const struct cpuset *cur, const struct cpuset *trial)
 	cpuset_for_each_child(c, cont, par) {
 		if ((is_cpu_exclusive(trial) || is_cpu_exclusive(c)) &&
 		    c != cur &&
-		    cpumask_intersects(trial->cpus_allowed, c->cpus_allowed))
+		    cpumask_intersects(trial->cpus_requested, c->cpus_requested))
 			goto out;
 		if ((is_mem_exclusive(trial) || is_mem_exclusive(c)) &&
 		    c != cur &&
@@ -879,21 +887,29 @@ static int update_cpumask(struct cpuset *cs, struct cpuset *trialcs,
 	 * with tasks have cpus.
 	 */
 	if (!*buf) {
+		cpumask_clear(trialcs->cpus_requested);
 		cpumask_clear(trialcs->cpus_allowed);
 	} else {
-		retval = cpulist_parse(buf, trialcs->cpus_allowed);
+		retval = cpulist_parse(buf, trialcs->cpus_requested);
 		if (retval < 0)
 			return retval;
 
-		if (!cpumask_subset(trialcs->cpus_allowed, cpu_active_mask))
+		/*
+		 * The request may name CPUs that are offline at the moment;
+		 * they join cpus_allowed when they come up.
+		 */
+		if (!cpumask_subset(trialcs->cpus_requested, cpu_present_mask))
 			return -EINVAL;
+
+		cpumask_and(trialcs->cpus_allowed, trialcs->cpus_requested,
+			    cpu_active_mask);
 	}
 	retval = validate_change(cs, trialcs);
 	if (retval < 0)
 		return retval;
 
 	/* Nothing to do if the cpus didn't change */
-	if (cpumask_equal(cs->cpus_allowed, trialcs->cpus_allowed))
+	if (cpumask_equal(cs->cpus_requested, trialcs->cpus_requested))
 		return 0;
 
 	retval = heap_init(&heap, PAGE_SIZE, GFP_KERNEL, NULL);
@@ -904,6 +920,7 @@ static int update_cpumask(struct cpuset *cs, struct cpuset *trialcs,
 
 	mutex_lock(&callback_mutex);
 	cpumask_copy(cs->cpus_allowed, trialcs->cpus_allowed);
+	cpumask_copy(cs->cpus_requested, trialcs->cpus_requested);
 	mutex_unlock(&callback_mutex);
 
 	/*
@@ -1653,7 +1670,7 @@ static size_t cpuset_sprintf_cpulist(char *page, struct cpuset *cs)
 	size_t count;
 
 	mutex_lock(&callback_mutex);
-	count = cpulist_scnprintf(page, PAGE_SIZE, cs->cpus_allowed);
+	count = cpulist_scnprintf(page, PAGE_SIZE, cs->cpus_requested);
 	mutex_unlock(&callback_mutex);
 
 	return count;
@@ -1864,19 +1881,26 @@ static struct cgroup_subsys_state *cpuset_css_alloc(struct cgroup *cont)
 	cs = kzalloc(sizeof(*cs), GFP_KERNEL);
 	if (!cs)
 		return ERR_PTR(-ENOMEM);
-	if (!alloc_cpumask_var(&cs->cpus_allowed, GFP_KERNEL)) {
-		kfree(cs);
-		return ERR_PTR(-ENOMEM);
-	}
+	if (!alloc_cpumask_var(&cs->cpus_allowed, GFP_KERNEL))
+		goto error_allowed;
+	if (!alloc_cpumask_var(&cs->cpus_requested, GFP_KERNEL))
+		goto error_requested;
 
 	set_bit(CS_SCHED_LOAD_BALANCE, &cs->flags);
 	cpumask_clear(cs->cpus_allowed);
+	cpumask_clear(cs->cpus_requested);
 	nodes_clear(cs->mems_allowed);
 	fmeter_init(&cs->fmeter);
 	INIT_WORK(&cs->hotplug_work, cpuset_propagate_hotplug_workfn);
 	cs->relax_domain_level = -1;
 
 	return &cs->css;
+
+error_requested:
+	free_cpumask_var(cs->cpus_allowed);
+error_allowed:
+	kfree(cs);
+	return ERR_PTR(-ENOMEM);
 }
 
 static int cpuset_css_online(struct cgroup *cgrp)
@@ -1927,6 +1951,7 @@ static int cpuset_css_online(struct cgroup *cgrp)
 	mutex_lock(&callback_mutex);
 	cs->mems_allowed = parent->mems_allowed;
 	cpumask_copy(cs->cpus_allowed, parent->cpus_allowed);
+	cpumask_copy(cs->cpus_requested, parent->cpus_requested);
 	mutex_unlock(&callback_mutex);
 out_unlock:
 	mutex_unlock(&cpuset_mutex);
@@ -1959,6 +1984,7 @@ static void cpuset_css_free(struct cgroup *cont)
 	struct cpuset *cs = cgroup_cs(cont);
 
 	free_cpumask_var(cs->cpus_allowed);
+	free_cpumask_var(cs->cpus_requested);
 	kfree(cs);
 }
 
@@ -1988,8 +2014,11 @@ int __init cpuset_init(void)
 
 	if (!alloc_cpumask_var(&top_cpuset.cpus_allowed, GFP_KERNEL))
 		BUG();
+	if (!alloc_cpumask_var(&top_cpuset.cpus_requested, GFP_KERNEL))
+		BUG();
 
 	cpumask_setall(top_cpuset.cpus_allowed);
+	cpumask_setall(top_cpuset.cpus_requested);
 	nodes_setall(top_cpuset.mems_allowed);
 
 	fmeter_init(&top_cpuset.fmeter);
@@ -2039,26 +2068,28 @@ static void remove_tasks_in_empty_cpuset(struct cpuset *cs)
  * cpuset_propagate_hotplug_workfn - propagate CPU/memory hotplug to a cpuset
  * @cs: cpuset in interest
  *
- * Compare @cs's cpu and mem masks against top_cpuset and if some have gone
- * offline, update @cs accordingly.  If @cs ends up with no CPU or memory,
- * all its tasks are moved to the nearest ancestor with both resources.
+ * Recompute @cs's cpus from the cpus it requested and the ones that are
+ * active now, so that cpus which went offline leave @cs and cpus which came
+ * back rejoin it, and drop mems that have gone offline.  If @cs ends up with
+ * no CPU or memory, all its tasks are moved to the nearest ancestor with
+ * both resources.
  */
 static void cpuset_propagate_hotplug_workfn(struct work_struct *work)
 {
-	static cpumask_t off_cpus;
+	static cpumask_t new_allowed;
 	static nodemask_t off_mems, tmp_mems;
 	struct cpuset *cs = container_of(work, struct cpuset, hotplug_work);
 	bool is_empty;
 
 	mutex_lock(&cpuset_mutex);
 
-	cpumask_andnot(&off_cpus, cs->cpus_allowed, top_cpuset.cpus_allowed);
+	cpumask_and(&new_allowed, cs->cpus_requested, top_cpuset.cpus_allowed);
 	nodes_andnot(off_mems, cs->mems_allowed, top_cpuset.mems_allowed);
 
-	/* remove offline cpus from @cs */
-	if (!cpumask_empty(&off_cpus)) {
+	/* drop cpus that went offline from @cs, put back the ones that returned */
+	if (!cpumask_equal(&new_allowed, cs->cpus_allowed)) {
 		mutex_lock(&callback_mutex);
-		cpumask_andnot(cs->cpus_allowed, cs->cpus_allowed, &off_cpus);
+		cpumask_copy(cs->cpus_allowed, &new_allowed);
 		mutex_unlock(&callback_mutex);
 		update_tasks_cpumask(cs, NULL);
 	}
@@ -2123,19 +2154,19 @@ static void schedule_cpuset_propagate_hotplug(struct cpuset *cs)
  * order to make cpusets transparent (of no affect) on systems that are
  * actively using CPU hotplug but making no active use of cpusets.
  *
- * Non-root cpusets are only affected by offlining.  If any CPUs or memory
- * nodes have been taken down, cpuset_propagate_hotplug() is invoked on all
- * descendants.
+ * Non-root cpusets follow in both directions: a CPU that goes down leaves
+ * every cpuset, and one that comes up rejoins the cpusets that requested it
+ * (see cpuset->cpus_requested).  If the set of CPUs or memory nodes changed,
+ * cpuset_propagate_hotplug() is invoked on all descendants.
  *
  * Note that CPU offlining during suspend is ignored.  We don't modify
  * cpusets across suspend/resume cycles at all.
  */
 static void cpuset_hotplug_workfn(struct work_struct *work)
 {
-	static cpumask_t new_cpus, tmp_cpus;
+	static cpumask_t new_cpus;
 	static nodemask_t new_mems, tmp_mems;
 	bool cpus_updated, mems_updated;
-	bool cpus_offlined, mems_offlined;
 
 	mutex_lock(&cpuset_mutex);
 
@@ -2144,12 +2175,7 @@ static void cpuset_hotplug_workfn(struct work_struct *work)
 	new_mems = node_states[N_MEMORY];
 
 	cpus_updated = !cpumask_equal(top_cpuset.cpus_allowed, &new_cpus);
-	cpus_offlined = cpumask_andnot(&tmp_cpus, top_cpuset.cpus_allowed,
-				       &new_cpus);
-
 	mems_updated = !nodes_equal(top_cpuset.mems_allowed, new_mems);
-	nodes_andnot(tmp_mems, top_cpuset.mems_allowed, new_mems);
-	mems_offlined = !nodes_empty(tmp_mems);
 
 	/* synchronize cpus_allowed to cpu_active_mask */
 	if (cpus_updated) {
@@ -2168,8 +2194,8 @@ static void cpuset_hotplug_workfn(struct work_struct *work)
 		update_tasks_nodemask(&top_cpuset, &tmp_mems, NULL);
 	}
 
-	/* if cpus or mems went down, we need to propagate to descendants */
-	if (cpus_offlined || mems_offlined) {
+	/* if cpus or mems changed, we need to propagate to descendants */
+	if (cpus_updated || mems_updated) {
 		struct cpuset *cs;
 		struct cgroup *pos_cgrp;
 
